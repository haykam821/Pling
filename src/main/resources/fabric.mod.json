{
	"schemaVersion": 1,
	"id": "pling",
	"version": "${version}",

	"name": "Pling",
	"description": "Plays a sound when Minecraft is finished loading.",
	"authors": [
		"haykam821"
	],
	"contact": {
		"homepage": "https://github.com/haykam821/Pling#readme",
		"issues": "https://github.com/haykam821/Pling/issues"
	},

	"license": "MIT",
	"icon": "assets/pling/icon.png",

	"environment": "client",
	"entrypoints": {
		"main": [
			"io.github.haykam821.pling.Pling"
		],
		"modmenu": [
			"io.github.haykam821.pling.config.ModMenuCompatibility"
		]
	},
	"mixins": [
		"pling.mixin.json"
	],
	"custom": {
		"modmenu": {
			"links": {
				"modmenu.discord": "https://haykam.com/links/discord"
			}
		}
	},

	"depends": {
		"fabricloader": ">=0.4.0",
		"cloth-config2": "*",
		"java": ">=21"
	}
